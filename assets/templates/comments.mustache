{{#comments}}
	<li id="comment-{{id}}" data-comment-id="{{id}}">
		<p class="metadata {{#deleted}}deleted{{/deleted}}">
			{{#deleted}}<span>[deleted]</span>{{/deleted}}
			{{^deleted}}<a href="https://news.ycombinator.com/user?id={{user}}" target="_blank"><b class="user">{{user}}</b></a>{{/deleted}}
			<time><a href="https://news.ycombinator.com/item?id={{id}}" target="_blank">{{time_ago}}</a>{{#parent_id}} · <a href="#/item/{{story_id}}/comment/{{parent_id}}" class="parent-link">parent</a>{{/parent_id}}</time>
		</p>
		{{^deleted}}
			<p>{{{content}}}
			<ul>
				{{>comments_list}}
			</ul>
		{{/deleted}}
	</li>
{{/comments}}
